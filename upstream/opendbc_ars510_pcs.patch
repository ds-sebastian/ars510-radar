diff --git a/opendbc/car/toyota/carstate.py b/opendbc/car/toyota/carstate.py
index 6e134b28..6ea8939e 100644
--- a/opendbc/car/toyota/carstate.py
+++ b/opendbc/car/toyota/carstate.py
@@ -153,6 +153,11 @@ class CarState(CarStateBase):
       self.acc_type = cp_acc.vl["ACC_CONTROL"]["ACC_TYPE"]
       ret.stockFcw = bool(cp_acc.vl["PCS_HUD"]["FCW"])
 
+    # radar-ACC cars: the radar also reports its PCS alarm on its own bus, which keeps running when openpilot disables the radar
+    if self.CP.flags & ToyotaFlags.RADAR_ACC:
+      pcs = can_parsers[Bus.radar].vl["PCS_STATE"]
+      ret.stockFcw = ret.stockFcw or bool(pcs["PCS_ALARM"] and pcs["POWER_UP"] == 0)
+
     # some TSS2 cars have low speed lockout permanently set, so ignore on those cars
     # these cars are identified by an ACC_TYPE value of 2.
     # TODO: it is possible to avoid the lockout and gain stop and go if you
@@ -207,7 +212,11 @@ class CarState(CarStateBase):
       ("BLINKERS_STATE", float('nan')),
     ]
 
-    return {
+    parsers = {
       Bus.pt: CANParser(DBC[CP.carFingerprint][Bus.pt], pt_messages, 0),
       Bus.cam: CANParser(DBC[CP.carFingerprint][Bus.pt], [], 2),
     }
+    if CP.flags & ToyotaFlags.RADAR_ACC:
+      # not required (nan), so a quiet radar bus never makes CAN invalid
+      parsers[Bus.radar] = CANParser(DBC[CP.carFingerprint][Bus.radar], [("PCS_STATE", float('nan'))], 1)
+    return parsers
diff --git a/opendbc/car/toyota/tests/test_toyota.py b/opendbc/car/toyota/tests/test_toyota.py
index 02c3b48f..4d37ec5f 100644
--- a/opendbc/car/toyota/tests/test_toyota.py
+++ b/opendbc/car/toyota/tests/test_toyota.py
@@ -65,6 +65,16 @@ class TestToyotaInterfaces(unittest.TestCase):
     pt, = reports[-1].points
     assert pt.trackId == 7 and abs(pt.dRel - 61.5) < 1e-6 and abs(pt.yRel - 0.42) < 1e-6 and abs(pt.vRel + 3.25) < 1e-6
 
+  def test_ars510_pcs_alarm(self):
+    # The radar's PCS alarm on its own bus is the car's FCW; its first frame after power-up (FF FF) is not
+    CI = CarInterface(get_params(CAR.TOYOTA_RAV4_TSS2_2023))
+    packer = CANPacker("toyota_tss2_ars510")
+    for i, (values, fcw) in enumerate((({"PCS_ALARM": 1, "POWER_UP": 255}, False), ({"PCS_ALARM": 1}, True), ({}, False))):
+      CS = CI.update([(int(i * 1e8), [packer.make_can_msg("PCS_STATE", 1, values)])])
+      assert CS.stockFcw == fcw
+    CI.update([(int(5e9), [])])
+    assert CI.can_parsers[Bus.radar].can_valid  # a quiet radar bus never makes CAN invalid
+
   def test_essential_ecus(self):
     # Asserts standard ECUs exist for each platform
     common_ecus = {Ecu.fwdRadar, Ecu.fwdCamera}
