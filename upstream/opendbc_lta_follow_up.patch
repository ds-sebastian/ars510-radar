diff --git a/opendbc/car/toyota/carcontroller.py b/opendbc/car/toyota/carcontroller.py
index 8216a4f8..143a8281 100644
--- a/opendbc/car/toyota/carcontroller.py
+++ b/opendbc/car/toyota/carcontroller.py
@@ -53,6 +53,7 @@ class CarController(CarControllerBase):
     self.last_torque = 0
     self.last_angle = 0
     self.alert_active = False
+    self.follow_up_frame = -1000  # last frame the LTA follow-up display condition held
     self.standstill_req = False
     self.permit_braking = True
     self.steer_rate_counter = 0
@@ -286,10 +287,17 @@ class CarController(CarControllerBase):
         # forcing the pcm to disengage causes a bad fault sound so play a good sound instead
         send_ui = True
 
+      # LTA follow-up display (dots on the distance bars): steering with a lead while a lane line is weak, held 1 s
+      follow_up_lead = CC.latActive and hud_control.leadVisible
+      if follow_up_lead and not (hud_control.leftLaneVisible and hud_control.rightLaneVisible):
+        self.follow_up_frame = self.frame
+      follow_up = follow_up_lead and self.frame - self.follow_up_frame < 100
+
       if self.frame % 20 == 0 or send_ui:
         can_sends.append(toyotacan.create_ui_command(self.packer, steer_alert, pcm_cancel_cmd, hud_control.leftLaneVisible,
                                                      hud_control.rightLaneVisible, hud_control.leftLaneDepart,
-                                                     hud_control.rightLaneDepart, CC.enabled, CS.lkas_hud))
+                                                     hud_control.rightLaneDepart, CC.enabled, CS.lkas_hud,
+                                                     follow_up=follow_up))
 
       if (self.frame % 100 == 0 or send_ui) and self.CP.flags & ToyotaFlags.DISABLE_RADAR.value:
         can_sends.append(toyotacan.create_fcw_command(self.packer, fcw_alert))
diff --git a/opendbc/car/toyota/toyotacan.py b/opendbc/car/toyota/toyotacan.py
index b8878514..1beba444 100644
--- a/opendbc/car/toyota/toyotacan.py
+++ b/opendbc/car/toyota/toyotacan.py
@@ -110,18 +110,20 @@ def create_fcw_command(packer, fcw):
   return packer.make_can_msg("PCS_HUD", 0, values)
 
 
-def create_ui_command(packer, steer, chime, left_line, right_line, left_lane_depart, right_lane_depart, enabled, stock_lkas_hud):
+def create_ui_command(packer, steer, chime, left_line, right_line, left_lane_depart, right_lane_depart, enabled, stock_lkas_hud,
+                      follow_up=False):
   values = {
     "TWO_BEEPS": chime,
     "LDA_ALERT": steer,
     "RIGHT_LINE": 3 if right_lane_depart else 1 if right_line else 2,
     "LEFT_LINE": 3 if left_lane_depart else 1 if left_line else 2,
-    "BARRIERS": 1 if enabled else 0,
+    "BARRIERS": 1 if enabled and not follow_up else 0,
+    "LTA_FOLLOW_UP": 1 if follow_up else 0,
 
     # static signals
     "SET_ME_X02": 2,
     "SET_ME_X01": 1,
-    "LKAS_STATUS": 1,
+    "LKAS_STATUS": 2 if enabled else 1,
     "REPEATED_BEEPS": 0,
     "LANE_SWAY_FLD": 7,
     "LANE_SWAY_BUZZER": 0,
