diff --git a/opendbc/car/toyota/tests/test_ars510_acc_target.py b/opendbc/car/toyota/tests/test_ars510_acc_target.py
new file mode 100644
index 00000000..ea70ad7a
--- /dev/null
+++ b/opendbc/car/toyota/tests/test_ars510_acc_target.py
@@ -0,0 +1,94 @@
+import unittest
+
+from opendbc.can import CANPacker
+from opendbc.car import Bus, gen_empty_fingerprint, structs
+from opendbc.car.toyota.interface import CarInterface
+from opendbc.car.toyota.ars510_acc_target import RADAR_DBC, RadarInterface
+from opendbc.car.toyota.values import ARS510_FW_VERSIONS, ARS510_RADAR, CAR, DBC
+
+# recorded ACC target frames (0x235, 0x237) of one followed car, and the radar's idle payload without a target
+RECORDED = [
+  ("B24567806B13D60E", "A64297BA611C0550", 14, 33.175, -1.32, 0.375),
+  ("9BC56180CB13F20E", "2DC3BB3E5923FD50", 14, 47.75, -0.05, 0.75),
+  ("F135657F8AEBD50E", "10334D3D4123FD50", 14, 42.25, -0.4, -0.5),
+]
+IDLE_235, IDLE_237 = bytes.fromhex("000164800B2400FF"), bytes.fromhex("00000000003E8000")
+
+
+def with_counter(dat, counter):
+  """The rolling counter is the high nibble of byte 1."""
+  return dat[:1] + bytes([(counter % 16) << 4 | dat[1] & 0x0F]) + dat[2:]
+
+
+def run(ri, frames, t0=0):
+  """Feed card-style updates at 100 Hz (one ACC frame pair every other update, as at 50 Hz); returns the reports."""
+  out = []
+  for i, pair in enumerate(frames):
+    for j in range(2):
+      can = [(0x235, with_counter(pair[0], i), 1), (0x237, with_counter(pair[1], i), 1)] if j == 0 and pair else []
+      rr = ri.update([(int(t0 + (2 * i + j) * 1e7), can)])
+      if rr is not None:
+        out.append(rr)
+  return out
+
+
+class TestArs510AccTarget(unittest.TestCase):
+  def setUp(self):
+    self.CP = structs.CarParams.new_message()
+    self.CP.carFingerprint = CAR.TOYOTA_RAV4_TSS2_2023
+
+  def test_rav4_radar_dbc(self):
+    for car in (CAR.TOYOTA_RAV4_TSS2_2022, CAR.TOYOTA_RAV4_TSS2_2023):
+      assert DBC[car][Bus.radar] == ARS510_RADAR == RADAR_DBC
+
+  def test_detection(self):
+    """Only an ARS510 (known radar FW, or its ACC target on bus 1 at fingerprinting) enables radar; other radars stay radarless."""
+    def params(car, radar_fw, acc_on_bus1):
+      fingerprint = gen_empty_fingerprint()
+      if acc_on_bus1:
+        fingerprint[1][0x235] = 8
+      car_fw = [structs.CarParams.CarFw(ecu="fwdRadar", fwVersion=radar_fw, address=0x750, subAddress=0xf)]
+      return CarInterface.get_params(car, fingerprint, car_fw, False, False, False)
+
+    ars510_fw, other_fw = next(iter(ARS510_FW_VERSIONS)), b'\x018821F0R01100\x00\x00\x00\x00'
+    for car in (CAR.TOYOTA_RAV4_TSS2_2022, CAR.TOYOTA_RAV4_TSS2_2023):
+      assert not params(car, ars510_fw, False).radarUnavailable  # cold start: the radar is not sending yet
+      assert not params(car, other_fw, True).radarUnavailable
+      CP = params(car, other_fw, False)
+      assert CP.radarUnavailable and CarInterface.RadarInterface(CP).ars510 is None
+
+  def test_recorded_frames(self):
+    for f235, f237, track_id, d_rel, y_rel, v_rel in RECORDED:
+      ri = RadarInterface(self.CP)
+      pair = (bytes.fromhex(f235), bytes.fromhex(f237))
+      reports = run(ri, [pair] * 20)
+      assert len(reports) == 8  # 20 Hz
+      pt, = reports[-1].points
+      assert pt.trackId == track_id
+      assert abs(pt.dRel - d_rel) < 1e-6 and abs(pt.yRel - y_rel) < 1e-6 and abs(pt.vRel - v_rel) < 1e-6
+
+  def test_packed_target(self):
+    packer = CANPacker(RADAR_DBC)
+    pair = (packer.make_can_msg("ACC_TARGET_1", 1, {"STATE": 5, "REL_SPEED": -3.25, "TARGET_ID": 7})[1],
+            packer.make_can_msg("ACC_TARGET_2", 1, {"LONG_DIST": 61.5, "LAT_DIST": 0.42, "PRESENT": 1})[1])
+    reports = run(RadarInterface(self.CP), [pair] * 30)
+    pt, = reports[-1].points
+    assert pt.trackId == 7 and abs(pt.dRel - 61.5) < 1e-6 and abs(pt.yRel - 0.42) < 1e-6 and abs(pt.vRel + 3.25) < 1e-6
+    assert not reports[-1].errors.canError
+
+  def test_stuck_counter_is_a_can_error(self):
+    ri = RadarInterface(self.CP)
+    pair = (bytes.fromhex(RECORDED[0][0]), bytes.fromhex(RECORDED[0][1]))
+    reports = [ri.update([(int(i * 1e7), [(0x235, pair[0], 1), (0x237, pair[1], 1)] if i % 2 == 0 else [])]) for i in range(40)]
+    assert [rr for rr in reports if rr is not None][-1].errors.canError
+
+  def test_no_target_and_silent_radar(self):
+    ri = RadarInterface(self.CP)
+    reports = run(ri, [(IDLE_235, IDLE_237)] * 20)
+    assert len(reports[-1].points) == 0 and not reports[-1].errors.canError
+    reports = run(ri, [None] * 20, t0=0.4e9)
+    assert len(reports[-1].points) == 0 and reports[-1].errors.canError
+
+
+if __name__ == "__main__":
+  unittest.main()
