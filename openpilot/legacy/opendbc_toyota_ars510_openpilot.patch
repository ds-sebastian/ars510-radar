diff --git a/opendbc/car/toyota/interface.py b/opendbc/car/toyota/interface.py
index 2090e7f..85448ab 100644
--- a/opendbc/car/toyota/interface.py
+++ b/opendbc/car/toyota/interface.py
@@ -3,7 +3,7 @@ from opendbc.car.toyota.carstate import CarState
 from opendbc.car.toyota.carcontroller import CarController
 from opendbc.car.toyota.radar_interface import RadarInterface
 from opendbc.car.toyota.values import Ecu, CAR, DBC, ToyotaFlags, CarControllerParams, MIN_ACC_SPEED, \
-                                                  EPS_SCALE, ToyotaSafetyFlags
+                                                  EPS_SCALE, ToyotaSafetyFlags, ARS510_FW_VERSIONS
 from opendbc.car.disable_ecu import disable_ecu
 from opendbc.car.interfaces import CarInterfaceBase
 
@@ -90,6 +90,14 @@ class CarInterface(CarInterfaceBase):
 
     ret.radarUnavailable = Bus.radar not in DBC[candidate]
 
+    # Continental ARS510 (RAV4 2022+ radar-ACC): tracks come from its native object list on bus 1. Detected by radar FW,
+    # because after power-up the object stream starts ~6 s after first CAN, later than CAN fingerprinting; the bus 1
+    # check covers unlisted firmware when the radar was already running (e.g. an openpilot restart).
+    ars510_fw = any(fw.ecu == 'fwdRadar' and fw.fwVersion in ARS510_FW_VERSIONS for fw in car_fw)
+    if ret.flags & ToyotaFlags.RADAR_ACC and (ars510_fw or {0x80, 0x85} <= fingerprint.get(1, {}).keys()):
+      ret.flags |= ToyotaFlags.ARS510_RADAR.value
+      ret.radarUnavailable = False
+
     # since we don't yet parse radar on TSS2 radar-based ACC cars, gate longitudinal behind alpha toggle
     if ret.flags & ToyotaFlags.RADAR_ACC:
       ret.alphaLongitudinalAvailable = True
diff --git a/opendbc/car/toyota/radar_interface.py b/opendbc/car/toyota/radar_interface.py
index 207b5a1..2978001 100755
--- a/opendbc/car/toyota/radar_interface.py
+++ b/opendbc/car/toyota/radar_interface.py
@@ -4,6 +4,7 @@ from opendbc.car import Bus
 from opendbc.car.structs import RadarData
 from opendbc.car.toyota.values import DBC, ToyotaFlags
 from opendbc.car.interfaces import RadarInterfaceBase
+from opendbc.car.toyota.ars510_radar_interface import Ars510RadarInterface
 
 
 def _create_radar_can_parser(CP):
@@ -35,11 +36,14 @@ class RadarInterface(RadarInterfaceBase):
 
     self.valid_cnt = {key: 0 for key in self.RADAR_A_MSGS}
 
-    self.rcp = None if CP.radarUnavailable else _create_radar_can_parser(CP)
+    self.ars510 = Ars510RadarInterface(CP) if CP.flags & ToyotaFlags.ARS510_RADAR else None
+    self.rcp = None if CP.radarUnavailable or self.ars510 is not None else _create_radar_can_parser(CP)
     self.trigger_msg = self.RADAR_B_MSGS[-1]
     self.updated_messages = set()
 
   def update(self, can_strings):
+    if self.ars510 is not None:
+      return self.ars510.update(can_strings)
     if self.rcp is None:
       return super().update(None)
 
diff --git a/opendbc/car/toyota/values.py b/opendbc/car/toyota/values.py
index efdef6a..1a3cf51 100644
--- a/opendbc/car/toyota/values.py
+++ b/opendbc/car/toyota/values.py
@@ -58,11 +58,20 @@ class ToyotaSafetyFlags(IntFlag):
   SECOC = (8 << 8)
 
 
+# Radar firmware confirmed to be a Continental ARS510 that sends the native object list (0x80) on bus 1.
+# 8821F0R01100 (RAV4 2022) is likely the same family but unconfirmed: add it once 0x80 is seen on bus 1 on such a car.
+ARS510_FW_VERSIONS = {
+  b'\x018821F0R03100\x00\x00\x00\x00',
+}
+
+
 class ToyotaFlags(IntFlag):
   # Detected flags
   HYBRID = 1
   HAS_BSM = 2  # blind spot monitoring
   DISABLE_RADAR = 4
+  # Continental ARS510 native object list (0x80 / 0x85 on bus 1): radar tracks from ars510_radar_interface
+  ARS510_RADAR = 4096
 
   # Static flags
   TSS2 = 8
