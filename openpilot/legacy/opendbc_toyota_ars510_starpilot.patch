     # No radar dbc for cars without DSU which are not TSS 2.0
     # TODO: make an adas dbc file for dsu-less models
     ret.radarUnavailable = Bus.radar not in DBC[candidate] or candidate in (NO_DSU_CAR - TSS2_CAR - {CAR.TOYOTA_CAMRY})
+
+    # Continental ARS510 (RAV4 2022+ radar-ACC): tracks come from its native object list on bus 1. Detected by radar FW,
+    # because after power-up the object stream starts ~6 s after first CAN, later than CAN fingerprinting; the bus 1
+    # check covers unlisted firmware when the radar was already running (e.g. an openpilot restart).
+    ars510_fw = any(fw.ecu == 'fwdRadar' and fw.fwVersion in ARS510_FW_VERSIONS for fw in car_fw)
+    if candidate in RADAR_ACC_CAR and (ars510_fw or {0x80, 0x85} <= fingerprint.get(1, {}).keys()):
+      ret.flags |= ToyotaFlags.ARS510_RADAR.value
+      ret.radarUnavailable = False
     if candidate == CAR.TOYOTA_CAMRY:
       ret.radarTimeStepDEPRECATED = 0.1
 
