diff --git a/opendbc/car/toyota/values.py b/opendbc/car/toyota/values.py
index dede289..3066dcd 100644
--- a/opendbc/car/toyota/values.py
+++ b/opendbc/car/toyota/values.py
@@ -61,12 +61,21 @@ class ToyotaSafetyFlags(IntFlag):
   ALT_CRUISE = (64 << 8)
 
 
+# Radar firmware confirmed to be a Continental ARS510 that sends the native object list (0x80) on bus 1.
+# 8821F0R01100 (RAV4 2022) is likely the same family but unconfirmed: add it once 0x80 is seen on bus 1 on such a car.
+ARS510_FW_VERSIONS = {
+  b'\x018821F0R03100\x00\x00\x00\x00',
+}
+
+
 class ToyotaFlags(IntFlag):
   # Detected flags
   HYBRID = 1
   DISABLE_RADAR = 4
   # The DSU's ACC messages are rerouted through the camera bus by an adapter.
   DSU_BYPASS = 8192
+  # Continental ARS510 native object list (0x80 / 0x85 on bus 1): radar tracks from ars510_radar_interface
+  ARS510_RADAR = 16384
 
   # Static flags
   TSS2 = 8
